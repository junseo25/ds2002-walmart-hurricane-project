      "cell_type": "code",
      "source": [
        "import requests\n",
        "import pandas as pd\n",
        "from urllib.parse import urlencode\n",
        "from datetime import date, timedelta\n",
        "\n",
        "#Since every store is in the same state, just set all state rows to the same value.\n",
        "store['state'] = 'FL'\n",
        "\n",
        "#Tallahassee is missing coords instead of dropping a store location\n",
        "store.loc[store['city'] == 'Tallahassee', ['latitude', 'longitude']] = [30.4383, -84.2807]\n",
        "\n",
        "#drop any duplicate rows that may have the same latitude and longitude\n",
        "store = store.drop_duplicates(subset=['latitude', 'longitude']).reset_index(drop=True)\n",
        "\n",
        "#copied from lab\n",
        "END = date.today() - timedelta(days=3)\n",
        "START = END - timedelta(days=2)\n",
        "\n",
        "BASE = 'https://archive-api.open-meteo.com/v1/archive'\n",
        "\n",
        "#generates an empty list to inpute data into outside of the for loop so it doesnt get reset\n",
        "all_weather_data = []\n",
        "#iterates through all the rows so that the parameters are all correct\n",
        "for i in range(len(store)):\n",
        "    store_id = store.loc[i, 'store_id']\n",
        "    city = store.loc[i, 'city']\n",
        "    lat = store.loc[i, 'latitude']\n",
        "    lon = store.loc[i, 'longitude']\n",
        "    state = store.loc[i, 'state']\n",
        "\n",
        "    # Assign appropriate timezone (Pensacola is in the Central Time Zone)\n",
        "    tz = 'America/Chicago' if city == 'Pensacola' else 'America/New_York'\n",
        "\n",
        "#parameters that the API looks for, fixed by the if else statement above for tz\n",
        "    params = {\n",
        "        'latitude': lat,\n",
        "        'longitude': lon,\n",
        "        'start_date': START.isoformat(),\n",
        "        'end_date': END.isoformat(),\n",
        "        'hourly': 'temperature_2m,precipitation',\n",
        "        'timezone': tz,\n",
        "    }\n",
        "\n",
        "    response = requests.get(BASE, params=params)\n",
        "\n",
        "#The response code is a successful one, no error occurs\n",
        "    if response.status_code == 200:\n",
        "        data = response.json()\n",
        "        #Prints our that it can display the data for a specific store\n",
        "        print(f\"Successfully fetched data for {store_id} ({city}, {state})\")\n",
        "#finds hourly data for each store, if hourly data at a specific hour does not exist, it returns empty value\n",
        "        hourly = data.get('hourly', {})\n",
        "        print(hourly)\n",
        "        if hourly:\n",
        "            temp_stores = pd.DataFrame({\n",
        "                'store_id': store_id,\n",
        "                'city': city,\n",
        "                'state': state,\n",
        "                'time': hourly.get('time'),\n",
        "                'temperature_2m': hourly.get('temperature_2m'),\n",
        "                'precipitation': hourly.get('precipitation')\n",
        "            })\n",
        "#adds the data to the list\n",
        "            all_weather_data.append(temp_stores)\n",
        "    else:\n",
        "        print(f\"Failed to fetch data for {store_id} ({city}): Status {response.status_code}\")\n",
        "\n",
        "\n",
        "\n"
